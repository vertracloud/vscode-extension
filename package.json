          "group": "navigation@0"
        },
        {
          "command": "vertraCloud.workspace.openInvite",
          "when": "view == vertraCloudWorkspaces && vertraCloud.connected",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "vertraCloud.app.showLogs",
          "when": "viewItem =~ /^app:/",
          "group": "inline"
        },
        {
          "command": "vertraCloud.app.open",
          "when": "viewItem =~ /^app:/",
          "group": "1_navigation"
        },
        {
          "command": "vertraCloud.app.openRemoteFiles",
          "when": "viewItem =~ /^app:/",
          "group": "1_navigation"
        },
        {
          "command": "vertraCloud.app.start",
          "when": "viewItem =~ /^app:down/",
          "group": "2_operate"
        },
        {
          "command": "vertraCloud.app.stop",
          "when": "viewItem =~ /^app:up/",
          "group": "2_operate"
        },
        {
          "command": "vertraCloud.app.restart",
          "when": "viewItem =~ /^app:up/",
          "group": "2_operate"
        },
        {
          "command": "vertraCloud.app.restartReinstall",
          "when": "viewItem =~ /^app:up/",
          "group": "2_operate"
        },
        {
          "command": "vertraCloud.app.restartForceBuild",
          "when": "viewItem =~ /^app:up/",
          "group": "2_operate"
        },
