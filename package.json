    "viewsContainers": {
      "activitybar": [
        {
          "id": "vertraCloud",
          "title": "Vertra Cloud",
          "icon": "resources/vertra-icon.svg"
        }
      ]
    },
    "views": {
      "vertraCloud": [
        {
          "id": "vertraCloudProject",
          "name": "%view.project%"
