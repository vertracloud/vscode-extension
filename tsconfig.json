{
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "Node16",
		"target": "ES2022",
		"outDir": "out",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"sourceMap": true,
		"rootDir": "src",
		"noEmit": true,
		"strict": true
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules"
	]
}
