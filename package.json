    "cloud",
    "deploy",
    "hosting",
    "paas"
  ],
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs --production",
    "build:dev": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "mkdir -p dist && npm run build && vsce package --no-dependencies -o dist/vertra-cloud-$npm_package_version.vsix",
    "package:inspect": "vsce ls",
    "package:check": "node scripts/inspect-vsix.mjs",
    "package:dev": "mkdir -p dist && VERTRA_API_URL=${VERTRA_API_URL:-http://localhost:4000} vsce package --no-dependencies -o dist/vertra-cloud-$npm_package_version-dev.vsix"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
