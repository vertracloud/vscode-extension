      "view/title": [
        {
          "command": "vertraCloud.refresh",
          "when": "view == vertraCloudProject",
          "group": "navigation@1"
        },
        {
          "command": "vertraCloud.refresh",
          "when": "view == vertraCloudApps",
          "group": "navigation@1"
        },
        {
          "command": "vertraCloud.organization.createFolder",
          "when": "view == vertraCloudApps && vertraCloud.connected",
          "group": "navigation@0"
        },
        {
          "command": "vertraCloud.refresh",
          "when": "view == vertraCloudDBs",
          "group": "navigation@1"
        },
        {
          "command": "vertraCloud.organization.createFolder",
          "when": "view == vertraCloudDBs && vertraCloud.connected",
          "group": "navigation@0"
        },
        {
          "command": "vertraCloud.refresh",
          "when": "view == vertraCloudWorkspaces",
          "group": "navigation@1"
        },
        {
          "command": "vertraCloud.organization.createFolder",
          "when": "view == vertraCloudWorkspaces && vertraCloud.connected",
          "group": "navigation@0"
        },
        {
          "command": "vertraCloud.refresh",
          "when": "view == vertraCloudAccount",
          "group": "navigation@1"
        },
        {
          "command": "vertraCloud.disconnect",
          "when": "view == vertraCloudAccount && vertraCloud.connected",
          "group": "navigation@2"
        },
        {
          "command": "vertraCloud.db.create",
          "when": "view == vertraCloudDBs && vertraCloud.connected",
          "group": "navigation@0"
        },
        {
          "command": "vertraCloud.workspace.create",
