          "group": "3_inspect"
        },
        {
          "command": "vertraCloud.app.manageEnvs",
          "when": "viewItem =~ /^app:/",
          "group": "4_manage"
        },
        {
          "command": "vertraCloud.app.manageSnapshots",
          "when": "viewItem =~ /^app:/",
          "group": "4_manage"
        },
        {
          "command": "vertraCloud.app.editConfig",
          "when": "viewItem =~ /^app:/",
          "group": "4_manage"
        },
        {
          "command": "vertraCloud.app.setSubdomain",
          "when": "viewItem =~ /^app:/",
          "group": "4_manage"
        },
        {
          "command": "vertraCloud.app.showDns",
          "when": "viewItem =~ /^app:.*:published/",
          "group": "4_manage"
        },
        {
          "command": "vertraCloud.app.purgeCache",
          "when": "viewItem =~ /^app:.*:published/",
          "group": "4_manage"
        },
        {
          "command": "vertraCloud.app.publish",
          "when": "viewItem =~ /^app:(?!.*:published)/",
          "group": "4_manage"
